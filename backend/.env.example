# ===== CriptoGuard =====
# Corretora suportada pelo ccxt (binance, mercadobitcoin, bybit...)
EXCHANGE=binance
SYMBOL=BTC/USDT
# Várias moedas ao mesmo tempo (o capital é dividido em partes iguais). Se vazio, usa SYMBOL.
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=4h

# Modo do robô: paper (simulação) ou live (dinheiro real)
MODE=paper

# Saldo inicial da simulação (na moeda de cotação, ex: USDT)
PAPER_START_BALANCE=1000

# Estratégia: cruzamento de médias móveis
SMA_FAST=20
SMA_SLOW=50

# Filtro de regime: alta = segue tendência, lateral = reversão à média, baixa = fica fora
USE_REGIME=true
REGIME_SMA=200             # preço acima da média 200 = viés de alta
ADX_PERIOD=14
ADX_MIN=20                 # ADX abaixo disso = mercado sem tendência (lateral)

# Reversão à média (só opera no regime lateral)
BB_PERIOD=20
BB_STD=2.0
RSI_PERIOD=14
RSI_BUY=35                 # compra abaixo da banda inferior com RSI abaixo disso

# Melhorias (a combinação que passou no walk-forward em BTC e ETH no gráfico de 4h)
TRAIL_ATR_MULT=3           # stop móvel: sobe junto com o preço (0 = desligado)
VOL_FILTER=0               # filtro de volume (0 = desligado)
USE_MEANREV=false          # reversão à média no mercado lateral

# Gestão de risco
RISK_PER_TRADE=0.01        # 1% do capital arriscado por operação
ATR_PERIOD=14
ATR_STOP_MULT=2.0          # stop = entrada - 2 x ATR
MAX_MONTHLY_LOSS=0.05      # perdeu 5% no mês, o robô para até o mês seguinte
FEE_RATE=0.001             # 0,1% por ordem

# Chaves da corretora (SÓ PARA MODO LIVE). Crie a chave SEM permissão de saque.
API_KEY=
API_SECRET=
USE_TESTNET=true

# Trava extra: o modo live só liga se esta frase estiver exatamente assim
LIVE_CONFIRM=

# ===== Servidor (Docker) =====
# Senha do painel. OBRIGATÓRIA no servidor. Use uma senha forte.
PANEL_USER=admin
PANEL_PASSWORD=
# Liga o robô sozinho quando o sistema sobe (o docker-compose já força true)
AUTO_START=false
